# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Atlas connection string (or any MongoDB instance). Required.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?appName=...
MONGODB_URI=
